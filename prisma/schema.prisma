// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  password    String
  
  resetToken  String?
  resetExpiry DateTime?

  forgotPasswordAttempts Int      @default(0)
  forgotPasswordFirstAttempt DateTime?
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String

  githubUrl   String?
  liveUrl     String?

  featured    Boolean  @default(false)

  projectImg  ProjectImage?
}

model ProjectImage {
  id                 String @id @default(cuid())
  imageUrl           String
  cloudinaryPublicId String
  imageName          String

  projectId String @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model About {
  id String @id @default(cuid())

  fullName        String
  summary         String
  roles           String[]
  profileImg      ProfileImage?

  bio             String?

  resume          Resume?

  github          String?
  linkedin        String?
  email           String?

  experienceYears Float?
  projectsCount   Int?
}

model ProfileImage {
  id                 String @id @default(cuid())
  imageUrl           String
  cloudinaryPublicId String
  imageName          String

  aboutId String @unique
  about   About @relation(fields: [aboutId], references: [id], onDelete: Cascade)
}

model Resume {
  id                 String @id @default(cuid())
  resumeUrl           String
  resumeCloudinaryPublicId String
  resumeName          String

  aboutId String @unique
  about   About @relation(fields: [aboutId], references: [id], onDelete: Cascade)
}

model Skill {
  id String @id @default(cuid())

  name  String
  icon  String
  order Int @default(0)

  createdAt DateTime @default(now())
}